# Copy to .env at the repository root and replace the placeholders.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DB_NAME=medigo
DB_USER=medigo
DB_PASSWORD=replace-with-a-random-database-password
DB_HOST=postgres
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
SENSOR_API_KEY=replace-with-a-random-device-token
MEDIGO_BASE_URL=http://localhost
# Enable only after validating the serialized model with your runtime.
ENABLE_XGBOOST=False
# Optional relay for calls across restrictive networks. Use your own credentials.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Enable only behind a configured HTTPS reverse proxy.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
