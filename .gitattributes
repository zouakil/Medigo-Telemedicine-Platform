* text=auto

# Consistent line endings across Windows, Linux, and Docker
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.json text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
LICENSE text eol=lf

# Preserve binary assets without text conversion
*.png binary
*.joblib binary
